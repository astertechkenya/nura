# NURA security headers (Netlify).
# Content-Security-Policy is ENFORCED (Phase 8): the browser refuses any script, style, font,
# image or connection the policy doesn't list, so injected code (XSS) can't load scripts from
# elsewhere or send data out. Anything it blocks is reported to /api/csp-report (routes/csp.js)
# and shows up in Render's logs as "CSP blocked something".
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://res.cloudinary.com; connect-src 'self' https://api.cloudinary.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; report-uri /api/csp-report
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fonts never change under the same name (a new version gets a new file name, like
# dm-sans-v18), so browsers may keep them for a year without asking again. Without this,
# Netlify's default makes the browser re-check every font on every page, and the page shows
# the stand-in font until the answer comes back: a visible flicker on each click.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Shared scripts change between deploys; make browsers check for a new version.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# The admin: never in search results, never cached (it shows private, changing data).
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
