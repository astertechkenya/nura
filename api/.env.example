# Copy this file to .env (same folder) and fill in real values. .env is git-ignored:
# it never leaves your computer. On Render, the same names go under Environment.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Neon → your project → Connection string. Use the "nura_dev" database here.
# It looks like: postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/nura_dev?sslmode=require
DATABASE_URL=

# A SECOND database that the tests wipe and rebuild on every run. Never your real data.
TEST_DATABASE_URL=

# Where the storefront runs locally (python ..\server.py serves port 8000).
SITE_URL=http://localhost:8000

# Shared with Netlify's signed proxy. Leave empty on your laptop; set the SAME long random
# value on Render and on Netlify (see netlify.toml) so the API can trust shopper IPs.
NETLIFY_PROXY_SECRET=

# A product counts as "New In" for this many days after arriving.
NEW_IN_DAYS=30

# Checkout (used from Phase 4)
FREE_SHIPPING_THRESHOLD_KES=5000
SHIPPING_FEE_KES=300

# Password for the two demo accounts created by `npm run db:seed`.
SEED_DEMO_PASSWORD=nura-demo-2026
