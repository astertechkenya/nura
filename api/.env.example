# Copy this file to .env (same folder) and fill in real values. .env is git-ignored:
# it never leaves your computer. On Render, the same names go under Environment.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Neon → your project → Connection string. Use the "nura_dev" database here.
# It looks like: postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/nura_dev?sslmode=require
# This is the DEVELOPMENT project. Production is a separate Neon project whose passwords never
# go in this file (ops/README.md).
DATABASE_URL=

# A SECOND database that the tests wipe and rebuild on every run. Never your real data.
TEST_DATABASE_URL=

# Where the storefront runs locally (python ..\server.py serves port 8000).
SITE_URL=http://localhost:8000

# Signs the sign-in cookie. Generate one per environment (laptop and Render get DIFFERENT values):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared with Netlify's signed proxy. Leave empty on your laptop; set the SAME long random
# value on Render and on Netlify (see netlify.toml) so the API can trust shopper IPs.
NETLIFY_PROXY_SECRET=

# A product counts as "New In" for this many days after arriving.
NEW_IN_DAYS=30

# Checkout (Phase 4)
FREE_SHIPPING_THRESHOLD_KES=5000
SHIPPING_FEE_KES=300
# Counties where cash on delivery is offered, comma-separated, spelled as in src/lib/kenya.js.
COD_COUNTIES=Nairobi
# Largest COD order in KES. Leave unset (commented out) for no limit.
# COD_MAX_KES=20000
# Minutes an unpaid M-Pesa/card order holds its stock (Phase 5).
PAYMENT_WINDOW_MINUTES=15

# M-Pesa via Daraja (Phase 5). M-Pesa shows at checkout only when ALL of these are set.
# From developer.safaricom.co.ke → My Apps → your app. Sandbox shortcode 174379 and its
# passkey are on Daraja's "Lipa na M-Pesa Online" test page (APIs → M-Pesa Express → Simulate).
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# The API's public address. Safaricom posts results here, straight to Render (not Netlify).
PUBLIC_API_URL=https://nura-api-w1nm.onrender.com
# A long random value, different on your laptop and on Render (same command as SESSION_SECRET).
MPESA_CALLBACK_SECRET=
# Sandbox only: what each test prompt asks for, instead of the order total.
DARAJA_SANDBOX_AMOUNT_KES=1

# Password for the two demo accounts created by `npm run db:seed`.
SEED_DEMO_PASSWORD=nura-demo-2026

# Cards and Apple Pay via Paystack (Phase 6). Card appears at checkout when this is set.
# From dashboard.paystack.com → Settings → API Keys & Webhooks. Test mode: sk_test_…
# In the same place, set the TEST webhook URL to:
#   https://nura-api-w1nm.onrender.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Email via Resend (Phase 7). Without a key: printed in this terminal (dev) / only logged (Render).
# From resend.com → API Keys → Create (permission: "Sending access").
RESEND_API_KEY=
# Until you verify a domain of your own, keep the default sender below AND set MAIL_ONLY_TO to
# the email you signed up to Resend with: Resend only delivers test-sender mail to that address,
# so emails to anyone else are held (logged) instead of failing.
# MAIL_FROM=NURA <onboarding@resend.dev>
MAIL_ONLY_TO=

# Product photos via Cloudinary (Phase 7). From cloudinary.com → Settings → API Keys.
# Without these the admin's photo upload says "not set up yet"; everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
