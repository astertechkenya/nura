{
  "name": "nura-api",
  "version": "0.1.0",
  "private": true,
  "description": "NURA commerce API: products, accounts, carts, orders and payments",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  }
}
